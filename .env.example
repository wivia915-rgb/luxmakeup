DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lux_makeup?schema=public"

# Shop owner WhatsApp number, country code plus digits, no plus sign. Example: 212612345678
LUX_OWNER_WHATSAPP="212679855411"

# Endpoint that receives COD orders for SMS / WhatsApp automation
COD_WEBHOOK_URL="https://example.com/hooks/lux-cod"

# Optional bearer token sent with the webhook
COD_WEBHOOK_SECRET=""

# Public site origin used for Open Graph URLs. WhatsApp and Instagram need an absolute https address.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Meta Pixel id, digits only. Leave blank to keep the pixel off.
NEXT_PUBLIC_META_PIXEL_ID=""

# OpenAI key for the product desk lifestyle portrait. https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Code that opens /admin. Restart the server after changing it.
ADMIN_CODE=""
