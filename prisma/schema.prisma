generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Amounts are whole Moroccan dirhams (DH).
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@map("categories")
}

model Product {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  price         Int
  discountPrice Int?
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description   String?
  descriptionLocales Json    @default("{}")
  titleLocales  Json    @default("{}")
  copyHash      String  @default("")
  highlights    String[] @default([])
  traits        String[] @default([])
  sellingLocales Json    @default("{}")
  ingredients   String[]
  images        String[]
  stock         Int         @default(0)
  available     Boolean     @default(true)
  featured      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ProductVariant[]
  formula       ProductIngredient[]
  orderItems    OrderItem[]

  @@index([categoryId, featured])
  @@index([featured, createdAt(sort: Desc)])
  @@index([stock])
  @@index([title])
  @@index([ingredients], type: Gin)
  @@map("products")
}

/// A shade, a volume, or both. Price adjustment is whole dirhams added to the piece price.
model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  colorCode       String?
  size            String?
  stock           Int      @default(0)
  priceAdjustment Int      @default(0)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, sortOrder])
  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductIngredient {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  benefit   String  @default("")
  locales   Json    @default("{}")
  icon      String  @default("leaf")
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_ingredients")
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  city         String
  address      String
  totalAmount  Int
  status       OrderStatus @default(PENDING)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([phone])
  @@index([city, status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  title     String
  shadeName String
  quantity  Int
  unitPrice Int

  @@index([orderId])
  @@index([productId])
  @@index([orderId, productId])
  @@map("order_items")
}

/// Either a percentage or a fixed dirham amount, never both.
model Coupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  discountPercentage Int?
  fixedAmount        Int?
  validUntil         DateTime
  isActive           Boolean  @default(true)
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, validUntil])
  @@index([code])
  @@map("coupons")
}

/// One row for the house. id is always "store".
model StoreSettings {
  id                    String   @id @default("store")
  announcement          String   @default("")
  announcementAr        String   @default("")
  announcementFr        String   @default("")
  announcementEn        String   @default("")
  freeShippingThreshold Int      @default(0)
  localShippingFee      Int      @default(0)
  standardShippingFee   Int      @default(35)
  remoteShippingFee     Int      @default(45)
  whatsapp              String   @default("")
  supportEmail          String   @default("")
  facebookPixelId       String   @default("")
  tiktokPixelId         String   @default("")
  maintenanceMode       Boolean  @default(false)
  agentEnabled          Boolean  @default(true)
  agentPrompt           String   @default("")
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

model ProductMedia {
  id        String   @id @default(cuid())
  mime      String
  bytes     Bytes
  createdAt DateTime @default(now())

  @@map("product_media")
}
