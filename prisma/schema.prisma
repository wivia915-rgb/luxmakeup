generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Amounts are whole Moroccan dirhams (DH).
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@map("categories")
}

model Product {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  price         Int
  discountPrice Int?
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description   String?
  ingredients   String[]
  images        String[]
  stock         Int         @default(0)
  available     Boolean     @default(true)
  featured      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]

  @@index([categoryId, featured])
  @@index([featured, createdAt(sort: Desc)])
  @@index([stock])
  @@index([title])
  @@index([ingredients], type: Gin)
  @@map("products")
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  city         String
  address      String
  totalAmount  Int
  status       OrderStatus @default(PENDING)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([phone])
  @@index([city, status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  title     String
  shadeName String
  quantity  Int
  unitPrice Int

  @@index([orderId])
  @@index([productId])
  @@index([orderId, productId])
  @@map("order_items")
}

/// Either a percentage or a fixed dirham amount, never both.
model Coupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  discountPercentage Int?
  fixedAmount        Int?
  validUntil         DateTime
  isActive           Boolean  @default(true)
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, validUntil])
  @@index([code])
  @@map("coupons")
}
